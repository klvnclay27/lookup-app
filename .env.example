EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key
# The backend reads these same public values while verifying user access tokens.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Backend only. Store this as a secret in Render; never use an EXPO_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
EXPO_PUBLIC_LOOKUP_BACKEND_URL=http://localhost:4000
# Comma-separated exact web origins permitted to call the deployed backend.
LOOKUP_ALLOWED_ORIGINS=https://lookup-app-kc.expo.app
# Optional override for staging/production password-reset callbacks.
EXPO_PUBLIC_LOOKUP_AUTH_REDIRECT_URL=https://your-app.example/sign-in
